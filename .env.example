# Copy to .env and fill in your own values. Do not commit .env.
#
# Obtain KeyId / KeySecret from SolisCloud: Service -> API Management.
# Treat SOLIS_KEY_SECRET like a password.

SOLIS_KEY_ID=your_key_id_here
SOLIS_KEY_SECRET=your_key_secret_here
SOLIS_API_BASE_URL=https://www.soliscloud.com:13333

# Optional. Fixed UTC offset (e.g. 10, or 9.5 for half-hour zones). Overrides
# the automatic per-device timezone lookup, which also applies daylight saving
# for the requested date. A fixed value is wrong for half the year in a DST
# zone, so leave this unset unless the lookup fails.
# SOLIS_DEFAULT_TIMEZONE=10

# Optional. Comma-separated tool groups to expose. Defaults to core.
# Groups: core, fleet, collector, warranty, epm, weather, meter, or all.
# SOLIS_TOOLSETS=core,collector

# Optional. Set to 1 to also expose the five tools that MODIFY the real
# installation: create_station, update_station, create_station_with_collector,
# bind_inverters, unbind_collector.
#
# unbind_collector with delete_inverters=1 deletes devices and their history
# with no undo. Leave this unset unless you specifically need write access.
# SOLIS_ENABLE_WRITES=1
